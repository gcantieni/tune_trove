    {
      "name": "recordings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recordings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"performers\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"modified_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "tunes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tunes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"abc\" TEXT NULL, \"abc_svg\" TEXT NULL, \"ts_id\" INTEGER NULL, \"from\" TEXT NULL, \"status\" TEXT NULL, \"key\" TEXT NULL, \"type\" TEXT NULL, \"genre\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"modified_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "tune_recording",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tune_recording\" (\"tune_id\" INTEGER NOT NULL, \"recording_id\" INTEGER NOT NULL, \"start_time\" INTEGER NULL, \"end_time\" INTEGER NULL, \"performers\" TEXT NULL, \"performed_key\" TEXT NULL, PRIMARY KEY (\"tune_id\", \"recording_id\"));"
        }
      ]
    },
    {
      "name": "tune_sets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tune_sets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"modified_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "set_tune",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"set_tune\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"set_id\" INTEGER NOT NULL REFERENCES tune_sets (id), \"tune_id\" INTEGER NOT NULL REFERENCES tunes (id), \"position\" INTEGER NOT NULL);"
        }
      ]
